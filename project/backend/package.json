{
  "name": "project-cars-backend",
  "version": "1.0.0",
  "description": "Backend for Venta Coches project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "server": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch \"**/src/tests/*.test.js\" --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.3"
  },
  "type": "module",
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/src/tests/*.test.js"],
    "verbose": true,
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  }
}
